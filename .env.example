# Copy to .env.local and fill in. Never commit .env.local.
# Anything without NEXT_PUBLIC_ is server-only and must never reach the browser.

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Manila
# Shared secret that Vercel Cron / pg_cron HTTP calls must send (generate a long random string)
CRON_SECRET=

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used for creating users, webhooks, cron jobs and other trusted writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used by the Supabase CLI (link / db push) and CI, not by the app at runtime
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# ---- Anthropic (server-only) ----
ANTHROPIC_API_KEY=
AI_MODEL_CUSTOMER=claude-opus-5-5
AI_MODEL_GRADER=claude-opus-5-5
AI_MODEL_QUIZ=claude-opus-5-5
# Phase 12
AI_MODEL_ASSISTANT=claude-opus-5-5
AI_MODEL_EXTRACTION=claude-opus-5-5

# ---- Email: Resend ----
RESEND_API_KEY=
EMAIL_FROM="JD Foods OS <noreply@jdfoods.ph>"
EMAIL_REPLY_TO=
# Phase 6 test inbox for scheduled-report checks
REPORTS_TEST_INBOX=

# ---- Payments: PayMongo (test keys until go-live) ----
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_WEBHOOK_SECRET=

# ---- Shopify (jdfoods.ph custom app, Admin API GraphQL) ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# The custom app's API secret key; used to verify webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=
# Shopify location that receives our available-to-sell stock (gid://shopify/Location/...)
SHOPIFY_LOCATION_ID=
